# FireMonkey — Required Environment Variables
# Copy this file to .env and fill in your API keys.
# DO NOT commit .env to version control.

# Alpha Vantage — Free tier: https://www.alphavantage.co/support/#api-key
ALPHA_VANTAGE_API_KEY=

# Finnhub — Free tier: https://finnhub.io/register
FINNHUB_API_KEY=

# Financial Datasets — https://financialdatasets.ai/
FINANCIAL_DATASETS_API_KEY=

# Alpaca — Free paper trading: https://app.alpaca.markets/signup
ALPACA_API_KEY=
ALPACA_API_SECRET=
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# Optional: PostgreSQL for persistent storage
# DATABASE_URL=postgresql://user:pass@localhost:5432/firemonkey

# Optional: Slack webhook for trade notifications
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/XXX/YYY/ZZZ
